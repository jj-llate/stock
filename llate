<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>My Wealth Diary</title>
  <!-- Google Fonts: 筆記体・エレガントセリフ体・日本語フォント -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #F8F5F0;
      --card-bg: #FFFFFF;
      --text-main: #4A423D;
      --text-sub: #8C827A;
      --text-light: #B5ACA4;
      --accent-brown: #9E8576;
      --accent-beige: #EBE3DB;
      --accent-soft-pink: #F5EAE6;
      --accent-gold: #C69C6D;
      --profit-red: #D96B6B;
      --loss-green: #5B8C73;
      --shadow-soft: 0 8px 24px rgba(160, 140, 125, 0.08);
      --shadow-card: 0 4px 16px rgba(180, 160, 145, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px;
      display: flex;
      justify-content: center;
    }

    .app-viewport {
      width: 100%;
      max-width: 440px;
      background-color: var(--bg-color);
      min-height: 100vh;
      position: relative;
      padding: 20px 18px;
    }

    /* 筆記体ヘッダー */
    .header {
      text-align: center;
      padding: 15px 0 20px 0;
    }

    .header-title {
      font-family: 'Alex Brush', cursive;
      font-size: 46px;
      color: #3E3631;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 1px;
    }

    .header-heart {
      font-size: 24px;
      color: #6E625A;
      margin: 4px 0 6px 0;
      display: block;
      font-weight: 300;
    }

    .header-sub {
      font-size: 11px;
      color: var(--text-sub);
      letter-spacing: 1.5px;
      font-weight: 300;
    }

    /* メインカード (共通) */
    .card {
      background: var(--card-bg);
      border-radius: 26px;
      padding: 22px;
      box-shadow: var(--shadow-soft);
      margin-bottom: 22px;
    }

    /* 総資産カード */
    .date-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: #F0ECE6;
      color: var(--text-sub);
      font-size: 11px;
      padding: 5px 12px;
      border-radius: 20px;
      font-weight: 400;
    }

    .good-script {
      font-family: 'Alex Brush', cursive;
      font-size: 26px;
      color: #A39387;
      float: right;
    }

    .asset-label {
      font-size: 12px;
      color: var(--text-sub);
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .asset-amount {
      font-family: 'Cormorant Garamond', serif;
      font-size: 38px;
      font-weight: 700;
      color: #332B25;
      margin: 4px 0 10px 0;
      letter-spacing: -0.5px;
    }

    .change-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--accent-soft-pink);
      color: var(--profit-red);
      font-size: 11px;
      font-weight: 500;
      padding: 4px 12px;
      border-radius: 12px;
    }

    /* Asset Allocation セクション */
    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 22px;
      color: #4A423D;
      margin-bottom: 12px;
      padding-left: 4px;
      font-weight: 600;
    }

    .allocation-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    /* ドーナツチャート (CSS conic-gradient) */
    .donut-chart-wrapper {
      position: relative;
      width: 110px;
      height: 110px;
      flex-shrink: 0;
    }

    .donut-chart {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: conic-gradient(
        #D2B49C 0% 53%,
        #E3D3C4 53% 85%,
        #F0E5D8 85% 100%
      );
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .donut-hole {
      width: 72px;
      height: 72px;
      background-color: #FFFFFF;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
    }

    .allocation-legend {
      flex-grow: 1;
      font-size: 11px;
      color: var(--text-main);
    }

    .legend-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      margin-right: 6px;
    }

    /* FIRE目標カード */
    .fire-card {
      background: #FBF8F3;
      border: 1px solid #F0ECE4;
      border-radius: 18px;
      padding: 12px 14px;
      text-align: center;
      width: 100px;
      flex-shrink: 0;
    }

    .fire-title {
      font-size: 10px;
      color: var(--text-sub);
      margin-bottom: 4px;
    }

    .fire-val {
      font-family: 'Cormorant Garamond', serif;
      font-size: 24px;
      font-weight: 700;
      color: #3E3631;
    }

    /* 銘柄一覧・リストスタイル */
    .list-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .btn-add {
      background: var(--accent-brown);
      color: white;
      border: none;
      padding: 7px 14px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 500;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(158, 133, 118, 0.25);
    }

    .stock-item {
      background: #FBF9F6;
      border-radius: 16px;
      padding: 14px;
      margin-bottom: 10px;
      border: 1px solid #F2ECE4;
      position: relative;
    }

    .stock-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .stock-code {
      font-size: 10px;
      background: #EFE9E0;
      color: var(--accent-brown);
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 6px;
    }

    .stock-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
    }

    .stock-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      font-size: 11px;
      margin-top: 8px;
      color: var(--text-sub);
    }

    .stock-val {
      font-weight: 600;
      color: var(--text-main);
    }

    .profit-text {
      color: var(--profit-red);
      font-weight: 700;
    }

    .loss-text {
      color: var(--loss-green);
      font-weight: 700;
    }

    .benefit-tag {
      margin-top: 8px;
      background: #FAF2EC;
      border: 1px dashed #E8D8CC;
      color: #A67C52;
      padding: 6px 10px;
      border-radius: 10px;
      font-size: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .btn-del {
      background: none;
      border: none;
      color: #D1C7BD;
      font-size: 14px;
      cursor: pointer;
    }

    /* ボトムナビゲーション (韓国風シンプル) */
    .navbar {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(10px);
      border-top: 1px solid #F0ECE6;
      display: flex;
      justify-content: space-around;
      padding: 10px 0 16px 0;
      z-index: 100;
    }

    .nav-btn {
      background: none;
      border: none;
      color: var(--text-light);
      font-size: 10px;
      font-weight: 500;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: pointer;
    }

    .nav-btn.active {
      color: var(--accent-brown);
      font-weight: 700;
    }

    .nav-icon {
      font-size: 18px;
    }

    /* モーダル */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(60, 50, 40, 0.4);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-card {
      background: white;
      width: 100%;
      max-width: 440px;
      border-radius: 28px 28px 0 0;
      padding: 24px;
      max-height: 85vh;
      overflow-y: auto;
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.1, 0.9, 0.2, 1);
    }

    .modal-overlay.active .modal-card {
      transform: translateY(0);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .form-group {
      margin-bottom: 12px;
    }

    .form-group label {
      display: block;
      font-size: 11px;
      color: var(--text-sub);
      margin-bottom: 4px;
      font-weight: 500;
    }

    .form-group input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #EFEAE4;
      background: #FBF9F6;
      border-radius: 12px;
      font-size: 13px;
      color: var(--text-main);
      outline: none;
    }

    .form-group input:focus {
      border-color: var(--accent-brown);
      background: #FFF;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .submit-btn {
      width: 100%;
      background: var(--accent-brown);
      color: white;
      border: none;
      padding: 13px;
      border-radius: 14px;
      font-size: 13px;
      font-weight: 700;
      margin-top: 10px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(158, 133, 118, 0.3);
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>
  <div class="app-viewport">
    
    <!-- 筆記体エレガントヘッダー -->
    <header class="header">
      <h1 class="header-title">My Wealth Diary</h1>
      <span class="header-heart">♡</span>
      <p class="header-sub">未来の自分へ、一歩ずつ♡</p>
    </header>

    <!-- 総資産カード -->
    <section class="card">
      <div>
        <span class="date-pill">📅 <span id="current-date">2026.11.11(水)</span></span>
        <span class="good-script">Good ♪ !</span>
      </div>
      <div class="asset-label">総資産 👁️</div>
      <div class="asset-amount" id="total-asset-val">¥0</div>
      <div>
        <span class="change-pill" id="total-profit-pill">前日比 +¥0 ▲ +0.00%</span>
      </div>
    </section>

    <!-- Asset Allocation (アセットアロケーション) -->
    <section class="card">
      <h2 class="section-title">Asset Allocation</h2>
      <div class="allocation-container">
        <!-- ドーナツグラフ -->
        <div class="donut-chart-wrapper">
          <div class="donut-chart">
            <div class="donut-hole">100%</div>
          </div>
        </div>
        <!-- 凡例 -->
        <div class="allocation-legend">
          <div class="legend-item">
            <span><span class="legend-dot" style="background:#D2B49C;"></span>株式</span>
            <span style="font-weight:600;">53%</span>
          </div>
          <div class="legend-item">
            <span><span class="legend-dot" style="background:#E3D3C4;"></span>ETF</span>
            <span style="font-weight:600;">32%</span>
          </div>
          <div class="legend-item">
            <span><span class="legend-dot" style="background:#F0E5D8;"></span>現金</span>
            <span style="font-weight:600;">15%</span>
          </div>
        </div>
        <!-- FIRE目標 -->
        <div class="fire-card">
          <div class="fire-title">👑 FIREまで</div>
          <div class="fire-val">56%</div>
        </div>
      </div>
    </section>

    <!-- メインコンテンツ (タブ切り替え) -->
    <main>
      <!-- タブ1: 資産一覧 -->
      <div id="tab-portfolio">
        <div class="list-header">
          <span class="section-title" style="margin:0; font-size:18px;">Portfolio</span>
          <button class="btn-add" onclick="openModal()">＋ 銘柄追加</button>
        </div>
        <div id="stock-list-container" style="margin-top:10px;"></div>
      </div>

      <!-- タブ2: 優待ノート -->
      <div id="tab-benefits" class="hidden">
        <div class="list-header">
          <span class="section-title" style="margin:0; font-size:18px;">Benefits Diary 🎁</span>
        </div>
        <div id="benefit-list-container" style="margin-top:10px;"></div>
      </div>

      <!-- タブ3: カレンダー -->
      <div id="tab-calendar" class="hidden">
        <div class="list-header">
          <span class="section-title" style="margin:0; font-size:18px;">Schedule 📅</span>
        </div>
        <div id="calendar-list-container" style="margin-top:10px;"></div>
      </div>
    </main>

    <!-- ボトムナビゲーションバー -->
    <nav class="navbar">
      <button class="nav-btn active" id="nav-portfolio" onclick="switchTab('portfolio')">
        <span class="nav-icon">🏠</span>
        <span>ホーム</span>
      </button>
      <button class="nav-btn" id="nav-benefits" onclick="switchTab('benefits')">
        <span class="nav-icon">🎁</span>
        <span>優待</span>
      </button>
      <button class="nav-btn" id="nav-calendar" onclick="switchTab('calendar')">
        <span class="nav-icon">📅</span>
        <span>予定</span>
      </button>
    </nav>

    <!-- 新規登録モーダル -->
    <div class="modal-overlay" id="modal-overlay">
      <div class="modal-card">
        <div class="modal-header">
          <span>🌸 銘柄の追加</span>
          <button onclick="closeModal()" style="border:none; background:none; font-size:20px; color:#AAA; cursor:pointer;">&times;</button>
        </div>
        <form onsubmit="handleAddStock(event)">
          <div class="form-group">
            <label>銘柄コード (任意)</label>
            <input type="text" id="inp-code" placeholder="例: 8267" maxlength="4">
          </div>
          <div class="form-group">
            <label>銘柄名</label>
            <input type="text" id="inp-name" placeholder="例: イオン" required>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>保有株数</label>
              <input type="number" id="inp-shares" value="100" required>
            </div>
            <div class="form-group">
              <label>購入単価 (円)</label>
              <input type="number" id="inp-buyPrice" placeholder="3100" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>現在株価 (円)</label>
              <input type="number" id="inp-curPrice" placeholder="3600" required>
            </div>
            <div class="form-group">
              <label>1株年間配当 (円)</label>
              <input type="number" id="inp-div" placeholder="40">
            </div>
          </div>
          <div class="form-group">
            <label>株主優待内容 (任意)</label>
            <input type="text" id="inp-benefit" placeholder="例: 3%キャッシュバック">
          </div>
          <button type="submit" class="submit-btn">追加する ♡</button>
        </form>
      </div>
    </div>

  </div>

  <script>
    // 初期データ (スクショ再現用)
    const DEFAULT_STOCKS = [
      { id: '1', code: '8267', name: 'イオン', shares: 500, buyPrice: 3100, currentPrice: 3600, divPerShare: 40, benefitName: '3%キャッシュバックカード', benefitStatus: '利用中' },
      { id: '2', code: '3197', name: 'すかいらーくHD', shares: 200, buyPrice: 2150, currentPrice: 2200, divPerShare: 17, benefitName: 'お食事優待券 4,000円分', benefitStatus: '受取済' },
      { id: '3', code: '4661', name: 'オリエンタルランド', shares: 100, buyPrice: 4200, currentPrice: 4500, divPerShare: 13, benefitName: '1デーパスポート', benefitStatus: '未届' }
    ];

    let stocks = JSON.parse(localStorage.getItem('my_wealth_diary_data')) || DEFAULT_STOCKS;

    function render() {
      localStorage.setItem('my_wealth_diary_data', JSON.stringify(stocks));

      let totalBuy = 0;
      let totalCurrent = 0;
      let stockHTML = '';
      let benefitHTML = '';
      let calendarHTML = '';

      stocks.forEach(s => {
        const buyVal = s.buyPrice * s.shares;
        const curVal = s.currentPrice * s.shares;
        const diff = curVal - buyVal;
        const diffRatio = buyVal > 0 ? ((diff / buyVal) * 100).toFixed(2) : '0.00';

        totalBuy += buyVal;
        totalCurrent += curVal;

        // Portfolio Item
        stockHTML += `
          <div class="stock-item">
            <div class="stock-header">
              <div>
                <span class="stock-code">${s.code || '----'}</span>
                <span class="stock-name">${s.name}</span>
              </div>
              <button class="btn-del" onclick="deleteStock('${s.id}')">✕</button>
            </div>
            <div class="stock-details">
              <div>評価額: <span class="stock-val">¥${curVal.toLocaleString()}</span></div>
              <div>損益: <span class="${diff >= 0 ? 'profit-text' : 'loss-text'}">${diff >= 0 ? '+' : ''}¥${diff.toLocaleString()} (${diffRatio}%)</span></div>
              <div>保有数: <span class="stock-val">${s.shares}株</span></div>
              <div>取得単価: <span class="stock-val">@¥${s.buyPrice.toLocaleString()}</span></div>
            </div>
            ${s.benefitName ? `
              <div class="benefit-tag">
                <span>🎁 ${s.benefitName}</span>
                <span style="font-weight:700;">${s.benefitStatus || '未届'}</span>
              </div>
            ` : ''}
          </div>
        `;

        // Benefits Item
        if(s.benefitName) {
          benefitHTML += `
            <div class="stock-item">
              <div class="stock-header">
                <div>
                  <span class="stock-code">${s.code || '----'}</span>
                  <span class="stock-name">${s.name}</span>
                </div>
              </div>
              <div class="benefit-tag" style="margin-top:4px;">
                <span>🎁 ${s.benefitName}</span>
                <span style="font-weight:700; color:var(--accent-brown);">${s.benefitStatus || '未届'}</span>
              </div>
            </div>
          `;
        }

        // Calendar Item
        calendarHTML += `
          <div class="stock-item" style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <span class="stock-code">${s.code || '----'}</span>
              <span class="stock-name">${s.name}</span>
              <div style="font-size:11px; color:var(--text-sub); margin-top:4px;">次回権利確定月: 3月/9月</div>
            </div>
            <div style="font-size:11px; text-align:right; font-weight:600; color:var(--accent-brown);">
              配当金予定<br>¥${((s.divPerShare || 0) * s.shares).toLocaleString()}
            </div>
          </div>
        `;
      });

      // 現金分を含めた総資産表示（スクショに合わせたエレガント表示）
      const totalProfit = totalCurrent - totalBuy;
      const profitRatio = totalBuy > 0 ? ((totalProfit / totalBuy) * 100).toFixed(2) : '0.00';
      
      document.getElementById('total-asset-val').innerText = `¥${totalCurrent.toLocaleString()}`;
      document.getElementById('total-profit-pill').innerText = `前日比 ${totalProfit >= 0 ? '+' : ''}¥${totalProfit.toLocaleString()} ▲ ${diffRatioStr(profitRatio)}%`;

      document.getElementById('stock-list-container').innerHTML = stockHTML || '<p style="font-size:12px; color:#AAA; text-align:center; padding:20px;">銘柄が登録されていません</p>';
      document.getElementById('benefit-list-container').innerHTML = benefitHTML || '<p style="font-size:12px; color:#AAA; text-align:center; padding:20px;">優待情報がありません</p>';
      document.getElementById('calendar-list-container').innerHTML = calendarHTML || '<p style="font-size:12px; color:#AAA; text-align:center; padding:20px;">予定はありません</p>';
    }

    function diffRatioStr(val) {
      return val >= 0 ? `+${val}` : `${val}`;
    }

    // タブ切り替え
    function switchTab(tabName) {
      document.getElementById('tab-portfolio').classList.toggle('hidden', tabName !== 'portfolio');
      document.getElementById('tab-benefits').classList.toggle('hidden', tabName !== 'benefits');
      document.getElementById('tab-calendar').classList.toggle('hidden', tabName !== 'calendar');

      document.getElementById('nav-portfolio').classList.toggle('active', tabName === 'portfolio');
      document.getElementById('nav-benefits').classList.toggle('active', tabName === 'benefits');
      document.getElementById('nav-calendar').classList.toggle('active', tabName === 'calendar');
    }

    // モーダル制御
    function openModal() {
      document.getElementById('modal-overlay').classList.add('active');
    }

    function closeModal() {
      document.getElementById('modal-overlay').classList.remove('active');
    }

    // 追加処理
    function handleAddStock(e) {
      e.preventDefault();
      const newStock = {
        id: Date.now().toString(),
        code: document.getElementById('inp-code').value,
        name: document.getElementById('inp-name').value,
        shares: Number(document.getElementById('inp-shares').value),
        buyPrice: Number(document.getElementById('inp-buyPrice').value),
        currentPrice: Number(document.getElementById('inp-curPrice').value),
        divPerShare: Number(document.getElementById('inp-div').value || 0),
        benefitName: document.getElementById('inp-benefit').value,
        benefitStatus: '未届'
      };

      stocks.push(newStock);
      closeModal();
      e.target.reset();
      render();
    }

    // 削除処理
    function deleteStock(id) {
      if(confirm('この銘柄を削除しますか？')) {
        stocks = stocks.filter(s => s.id !== id);
        render();
      }
    }

    // 初期化
    render();
  </script>
</body>
</html>
